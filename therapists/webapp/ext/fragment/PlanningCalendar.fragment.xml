<core:FragmentDefinition xmlns:unified="sap.ui.unified" 
	xmlns="sap.m" 
	xmlns:core="sap.ui.core" 
	xmlns:macros="sap.fe.macros"
>
	<VBox id="idFragmentCalendarVBox" core:require="{ handler: 'santos/therapists/ext/fragment/PlanningCalendar'}">
		
		<SinglePlanningCalendar id="idSinglePlanningCalendar"
			startHour="6"
			endHour="18"
			scaleFactor="0.5"
			appointments="{toAppointments}"
		>
		
			<views>
				<SinglePlanningCalendarDayView id="idSinglePlanningCalendarDayView" key="day" title="{i18n>day}"/>
				<SinglePlanningCalendarWeekView id="idSinglePlanningCalendarWeekView" key="week" title="{i18n>week}"/>
				<SinglePlanningCalendarMonthView id="idSinglePlanningCalendarMonthView" key="month" title="{i18n>month}"/>
			</views>

			<actions>
			
				<Button id="idNewAppointmentButton"
					text="{i18n>newAppointment}" 
					tooltip="{i18n>newAppointment}"
					type="Emphasized"
					visible="{= ${ui>/isEditable} }"
					press=".extension.santos.therapists.ext.controller.ObjectPage.onNewAppointmentButtonPress"
				/>

			</actions>

			<appointments>
			
				<unified:CalendarAppointment id="idCalendarAppointment"
					key="{block_ID}"
					title="{title}"
					description="{description}"
					startDate="{startDate}"
					endDate="{endDate2}"
				/>

			</appointments>

		</SinglePlanningCalendar>

	</VBox>

</core:FragmentDefinition>