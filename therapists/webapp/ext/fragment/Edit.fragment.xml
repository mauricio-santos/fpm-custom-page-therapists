<core:FragmentDefinition
	xmlns="sap.m"
	xmlns:core="sap.ui.core"
    xmlns:form="sap.ui.layout.form"
>

	<Dialog id="idEditDialog" title="{i18n>newAppointment}" draggable="true">
		
        <form:SimpleForm id="idEditPopoverSimpleForm">

            <Label id="idPatientEditLabel" text="{i18n>patient}" labelFor="idPatientsSetEditComboBox" required="true"/>
            <ComboBox id="idPatientsSetEditComboBox" items="{/PatientsSet}" selectedKey="{formModel>/patient_ID}">
                <core:Item id="idFullNameEditItem" key="{ID}" text="{fullName}"/>
            </ComboBox>

            <Label id="idTypeOfAppointmentEditLabel" text="{i18n>typeAppointment}" labelFor="idVhTypesAppointmentsEditComboBox" required="true"/>
            <ComboBox id="idVhTypesAppointmentsEditComboBox" items="{/VH_TypesAppointments}" selectedKey="{formModel>/typeAppointment_ID}">
                <core:Item id="idTypeEditItem" key="{ID}" text="{type}"/>
            </ComboBox>

            <Label id="idTitleEditLabel" text="{i18n>title}" labelFor="idTitleEditInput" required="true"/>
            <Input id="idTitleEditInput" value="{formModel>/title}" />

            <Label id="idDescriptionEditLabel" text="{i18n>description}" labelFor="idDescriptionEditInput"/>
            <Input id="idDescriptionEditInput" value="{formModel>/description}" />

            <Label id="idBeginDateEditLabel" text="{i18n>beginDate}" labelFor="idBeginDateEditDatePicker" required="true"/>
            <DatePicker id="idBeginDateEditDatePicker" 
                value="{formModel>/beginDate}"
                displayFormat="yyyy-MM-dd"
                change="onDatePickerChange"
            />

            <Label id="idEndDateEditLabel" text="{i18n>endDate}" labelFor="idEndDateEditDatePicker"/>
            <DatePicker id="idEndDateEditDatePicker" 
                value="{formModel>/endDate}"
                displayFormat="yyyy-MM-dd"
                enabled="false"
            />

            <Label id="idBlocksEditLabel" text="{i18n>blocks}" labelFor="idBlocksEditComboBox" required="true"/>
            <ComboBox id="idVhBlocksEditComboBox"
                items="{/VH_Blocks}" 
                selectedKey="{formModel>/block_ID}" 
                showSecondaryValues="true"
                change="onVhBlocksComboBoxChange"
            >
                <core:ListItem id="idBlockEditListItem" key="{ID}" text="{block}" additionalText="{timeText}"/>
            </ComboBox>

            <Label id="idBeginTimeEditLabel" text="{i18n>beginTime}" labelFor="idBeginTimeEditTimePicker"/>
            <TimePicker id="idBeginTimeEditTimePicker" value="{formModel>/beginTime}" enabled="false"/>

            <Label id="idEndTimeEditLabel" text="{i18n>endTime}" labelFor="idEndTimeEditTimePicker"/>
            <TimePicker id="idEndTimeEditTimePicker" value="{formModel>/endTime}" enabled="false"/>

        </form:SimpleForm>

        <beginButton>
            <Button id="idCancelEditButton" text="{i18n>cancel}" press="onCancelEditButtonPress"/>
		</beginButton>

		<endButton>
			<Button id="idSaveButton" text="{i18n>save}" type="Emphasized" press="onSaveButtonPress"/>
		</endButton>

	</Dialog>

</core:FragmentDefinition>